# ================================
# PRODUÇÃO — HOSTINGER
# ================================
NODE_ENV=production
PORT=3000

SITE_URL=https://fabianoreisimoveis.com.br
CORS_ORIGIN=https://fabianoreisimoveis.com.br
TRUST_PROXY=1

# Gere um segredo aleatório forte. NÃO reutilize este valor em produção.
# Ex.: openssl rand -hex 48
JWT_SECRET=COLOQUE_AQUI_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_48_BYTES

WHATSAPP_NUMBER=5521991822134
CONTATO_EMAIL=SEU_EMAIL_DE_ATENDIMENTO

# Persistência fora da pasta pública.
# Ajuste SEU_USUARIO para o usuário real da aplicação na Hostinger.
SQLITE_FILE=/home/SEU_USUARIO/fabiano-reis-data/database.db
MEDIA_ROOT=/home/SEU_USUARIO/fabiano-reis-media
STORAGE_PROVIDER=local

# Administrador inicial — use apenas durante o provisionamento.
# Depois de criar o administrador, remova ADMIN_PASSWORD do ambiente se desejar.
ADMIN_EMAIL=SEU_EMAIL_ADMIN
ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_COM_12_OU_MAIS_CARACTERES
ADMIN_NAME=Fabiano Reis

# Recuperação de senha / notificações por e-mail (opcional, recomendado).
# RESEND_API_KEY=...
# EMAIL_FROM=Fabiano Reis Imóveis <noreply@seu-dominio.com.br>
