{
  "name": "fabiano-reis-imoveis",
  "version": "1.0.0",
  "description": "Site imobiliário independente e pronto para produção, com catálogo, painel administrativo, leads, CRM e gestão de mídia.",
  "main": "server.js",
  "engines": {
    "node": ">=22.5 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node preflight.js",
    "test:smoke": "node scripts/smoke-test.js",
    "build:release": "node scripts/build-release.js",
    "admin:create": "node scripts/create-admin.js",
    "start:prod": "NODE_ENV=production node server.js",
    "check:syntax": "node --check server.js && node --check db-adapter.js && node --check storage/index.js",
    "verify": "npm run check && npm run check:syntax && npm run check:crm",
    "check:crm": "node --check public/crm.js && node --check server.js",
    "audit:release": "node scripts/audit-release.js",
    "production:gate": "node scripts/production-gate.js",
    "admin:reset": "node scripts/create-admin.js"
  },
  "keywords": [
    "imobiliária",
    "corretor",
    "imóveis",
    "venda",
    "aluguel"
  ],
  "author": "Fabiano Reis",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-static-gzip": "^2.1.8",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "optionalDependencies": {}
}
